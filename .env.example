APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# بعد migrate:fresh شغّل دائماً: php artisan db:seed  (أو migrate:fresh --seed)
# ينشئ حساب المدير فقط: admin@example.com / password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Use `public` for Filament uploads and Spatie Media Library (see config/filament.php + MEDIA_DISK).
FILESYSTEM_DISK=public
# Optional: override Filament's default upload disk (defaults to `public` in config/filament.php).
# FILAMENT_FILESYSTEM_DISK=public
# Spatie Media Library disk (must match a disk in config/filesystems.php).
MEDIA_DISK=public
# Media URLs default to root-relative `/storage` so they work on any host/port.
# Set a full URL only if you need absolute URLs (CDN, mailers): PUBLIC_DISK_URL=https://cdn.example.com/storage
# Use `redis` in production with `php artisan queue:work` for background jobs (reports, notifications).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_STORE=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Meilisearch (Laravel Scout) — database = SQL index, meilisearch = production search ---
SCOUT_DRIVER=database
# SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# SEO — استخدم نطاق الإنتاج مع HTTPS (مهم للمشاركة والفهرسة)
# SEO_CURRENCY=SAR

# المتجر — عدد العناصر في كل صفحة (أقسام / منتجات)
# STORE_PRODUCTS_PER_PAGE=15
# STORE_CATEGORIES_PER_PAGE=15
# STORE_MEDIA_CACHE_MAX_AGE=31536000

# --- WhatsApp (Mirsalli) — إشعارات طلبات التوصيل ---
# MIRSALLI_BASE_URL=https://mirsalli.com/myapp
# MIRSALLI_SEND_PATH=sendtextmsg.php
# MIRSALLI_USER=
# MIRSALLI_DEVICE=
# MIRSALLI_TIMEOUT=15
# MIRSALLI_RETRIES=2

# --- Production recommendations ---
# DB_CONNECTION=mysql
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
